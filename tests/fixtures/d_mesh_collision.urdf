<?xml version="1.0"?>
<!--
  SPDX-FileCopyrightText: Copyright (c) 2026 urdf-usd-bridge contributors
  SPDX-License-Identifier: Apache-2.0

  Fixture (d) - mesh colliders.

  Targets the one claim in docs/ANALYSIS.md section 1.4 that Phase 2.5 left
  source-only: "mesh colliders are always convexHull". Fixtures (a)-(c) use
  <box> collision geometry, so the converter authors no MeshCollisionAPI at all
  and the claim could not be tested behaviourally.

  mesh_link      - <collision> is a concave L-shaped <mesh>. Expect
                   MeshCollisionAPI with physics:approximation = "convexHull",
                   which fills the L's notch.
  Controls:
  box_link       - <collision> is a <box>, so no MeshCollisionAPI and no
                   approximation should be authored. Proves the assertion is
                   about meshes, not about every collider.
  visual_only_link - a <mesh> used for <visual> only, with no <collision>.
                   Proves the approximation follows the collider, not the mesh.
-->
<robot name="d_mesh_collision">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </collision>
  </link>

  <link name="mesh_link">
    <inertial>
      <origin xyz="0.03 0.03 0.02"/>
      <mass value="1.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <geometry><mesh filename="meshes/l_bracket.obj"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/l_bracket.obj"/></geometry>
    </collision>
  </link>

  <link name="box_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry><box size="0.05 0.05 0.1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.1"/></geometry>
    </collision>
  </link>

  <link name="visual_only_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><mesh filename="meshes/l_bracket.obj"/></geometry>
    </visual>
  </link>

  <joint name="base_to_mesh" type="revolute">
    <parent link="base_link"/>
    <child link="mesh_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="40.0" velocity="2.0"/>
    <dynamics damping="0.8" friction="0.2"/>
  </joint>

  <joint name="mesh_to_box" type="revolute">
    <parent link="mesh_link"/>
    <child link="box_link"/>
    <origin xyz="0.1 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="12.0" velocity="1.5"/>
  </joint>

  <joint name="box_to_visual" type="fixed">
    <parent link="box_link"/>
    <child link="visual_only_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

</robot>
