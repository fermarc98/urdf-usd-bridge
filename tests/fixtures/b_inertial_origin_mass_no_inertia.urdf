<?xml version="1.0"?>
<!--
  Fixture (b): <inertial> with an origin and a mass but no <inertia>.

  Written for urdf-usd-bridge. Not derived from any file in references/.

  Purpose: reproduce two distinct defects from one input.

  1. A body with positive mass and no inertia tensor. Both converter versions
     author physics:mass but leave the rotational inertia undefined, which each
     backend resolves differently (PhysX auto-computes from colliders, MuJoCo
     requires a positive-definite tensor, Newton reads newton:inertia).

  2. urdf-usd-converter 0.3.2 (the version Isaac Sim 6.1.0 pins) authors an
     all-zero physics:principalAxes quaternion for this exact shape of input,
     because apply_inertial() composes origin.rpy onto the (unauthored)
     principal-axes attribute. 0.3.3's CHANGELOG records the fix:
     "Fixed an invalid zero physics:principalAxes authored when <inertial>
      specifies origin and mass but no <inertia>".

  'no_inertia_no_collision_link' additionally has no collision geometry, so
  there is nothing for a backend to auto-compute an inertia tensor from.

  'control_link' is fully specified and must stay clean in every version; it is
  the negative control for the checks above.
-->
<robot name="b_inertial_origin_mass_no_inertia">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </collision>
  </link>

  <!-- origin (with a non-identity rpy) + mass, and deliberately no <inertia>. -->
  <link name="no_inertia_link">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0.3 0.2 0.1"/>
      <mass value="10.0"/>
    </inertial>
    <visual>
      <geometry><box size="0.1 0.1 0.2"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.1 0.1 0.2"/></geometry>
    </collision>
  </link>

  <!-- Same again, but with no collision geometry to fall back on. -->
  <link name="no_inertia_no_collision_link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="2.0"/>
    </inertial>
    <visual>
      <geometry><box size="0.06 0.06 0.1"/></geometry>
    </visual>
  </link>

  <link name="control_link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><box size="0.05 0.05 0.1"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.1"/></geometry>
    </collision>
  </link>

  <joint name="j_base_to_no_inertia" type="revolute">
    <parent link="base_link"/>
    <child link="no_inertia_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="20.0" velocity="1.0"/>
  </joint>

  <joint name="j_no_inertia_to_no_collision" type="revolute">
    <parent link="no_inertia_link"/>
    <child link="no_inertia_no_collision_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="5.0" velocity="1.0"/>
  </joint>

  <joint name="j_no_collision_to_control" type="revolute">
    <parent link="no_inertia_no_collision_link"/>
    <child link="control_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="1.0"/>
  </joint>

</robot>
